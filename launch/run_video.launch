<launch>
    <arg name="model_path" default="bbox/best.pt"/>
    <arg name="namespace" default="bluerov2"/>

    <group> 
        <push_ros_namespace namespace="$(var namespace)"/>

        <node pkg="bbox" exec="video" name="video" output="screen">
        </node>     

        <node pkg="bbox" exec="aruco_pool_node" name="aruco_pool_node" output="screen">
            <param name="camera_info_npz" value="bbox/pablos_camera_calb.npz"/>
            
            <param name="image_topic" value="camera/image"/>
            <param name="debug_image_topic" value="aruco/debug_image"/>
        </node>

        <node pkg="bbox" exec="bbox_yolo_detection" name="bbox_yolo_detection" output="screen">
            <param name="model_path" value="$(var model_path)"/>
            
            <param name="camera_topic" value="camera/image"/>
            
            <param name="show_display" value="true"/>
            <param name="conf_thres" value="0.5"/>
        </node>

    </group>
</launch>