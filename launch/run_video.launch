<launch>		
	<group> 
	<arg name="namespace" default="bluerov2"/>

	<node pkg="bbox" exec="video" name="video" namespace="$(var namespace)" output="screen">
	</node>		

	<node pkg="bbox" exec="aruco_pool_node" name="aruco_pool_node" output="screen">
		<param name="camera_info_npz" value="bbox/pablos_camera_calb.npz"/>
		<param name="image_topic" value="/camera/image"/>
		<param name="debug_image_topic" value="/aruco/debug_image"/>
	</node>

	
	</group>
</launch>	

